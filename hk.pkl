amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

// Linters, plus a security gate: nothing that looks like key material
// or a secret may be committed, and no oversized blobs either.
steps {
    ["actionlint"] = Builtins.actionlint
    ["golangci_lint"] = Builtins.golangci_lint
    ["golangci_lint_fmt"] = Builtins.golangci_lint_fmt
    ["go_fmt"] = Builtins.go_fmt
    ["gomod_tidy"] = Builtins.gomod_tidy
    ["go_vet"] = Builtins.go_vet
    ["zizmor"] = Builtins.zizmor
    ["taplo"] = Builtins.taplo
    ["gitleaks"] = Builtins.gitleaks
    ["detect_private_key"] = Builtins.detect_private_key
    ["check_added_large_files"] = Builtins.check_added_large_files
    ["keyfile_guard"] {
        check = "mise run guard:staged"
    }
}

hooks {
    ["pre-push"] {
        steps {
            ["tests"] {
                check = "mise run ci:test"
            }
            ["gitleaks-history"] {
                check = "mise run ci:leaks"
            }
        }
    }
}
